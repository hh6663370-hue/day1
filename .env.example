# 工单数据接口：请填写实际地址和认证信息
TICKET_API_URL=
TICKET_API_TOKEN=
TICKET_API_TIMEOUT_SECONDS=30

# 本地模型目录
QWEN_MODEL_PATH=D:/Tools/models/Qwen2.5-7B-Instruct

# 本地模型服务地址：启动服务后填写实际地址
QWEN_API_BASE_URL=
QWEN_MODEL_NAME=Qwen2.5-7B-Instruct
QWEN_API_TIMEOUT_SECONDS=120
# 最大模型调用次数（包含首次调用）；可改为任意正整数
QWEN_MAX_ATTEMPTS=3
QWEN_RETRY_DELAY_SECONDS=2

# 输出目录
OUTPUT_DIR=output

# 最大生成 token 数，给 600–900 字报告预留空间
QWEN_MAX_NEW_TOKENS=2048

